# ===== LLM 提供方 =====
# anthropic（Claude 官方）或 openai（任何 OpenAI 兼容端点：DeepSeek / 火山方舟 / vLLM ...）
LLM_PROVIDER=anthropic

# ----- Anthropic Claude -----
ANTHROPIC_API_KEY=
LEARNING_MODEL=claude-opus-5
# 跑测验/复习想省钱可换：claude-haiku-4-5

# ----- OpenAI 兼容端点（LLM_PROVIDER=openai 时必填下面三项）-----
# 注意：base_url 必须是 OpenAI 协议端点，不要带 /anthropic 后缀（那是另一套协议，会 404）。
#
# DeepSeek 示例：
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-v4-pro          # 2026-07 起 deepseek-chat 等旧名已下线
#
# 火山方舟示例（Model 填推理接入点 ID，不是模型名）：
#   OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   OPENAI_MODEL=ep-xxxxxxxx
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
